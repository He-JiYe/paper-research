# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl
*.tar.gz
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*,cover      # coverage artifacts with odd naming
*.cover
coverage/

# ── Virtual environment ──────────────────────────────
.venv/
venv/
env/
.uv/

# ── Project runtime data ─────────────────────────────
# 静态资源（前端 SPA / 邮件模板 / app-meta.json）统一在 app/（git 版本化）；
# data/ 仅存运行时数据库等动态数据，整体忽略
data/*
log/
*.db
*.db-shm
*.db-wal

# ── Sensitive configuration ─────────────────────────
config/settings.json
config/config.yaml
config/*.local.yaml

# ── IDE & Editor ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.vs/
*.suo
*.user

# ── OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── LLM Agent ─────────────────────────────────────
.claude/
.workbuddy

# ── tests ─────────────────────────────────────
# tests/ 已纳入版本控制

# ── download ─────────────────────────────────────
download/

# ── examples ─────────────────────────────────────
# few-shot 示例由运行时按关键词自动生成（手工补充才提交）
examples/*-few-shot.txt
